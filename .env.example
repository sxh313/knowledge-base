# AI Provider API Keys（仅用于首次启动时预填，实际存储在本地浏览器 IndexedDB）
# 复制此文件为 .env.local 并填入你的 Key（.env.local 已在 .gitignore 中，不会被提交）
# 之后也可以在 App「设置」页面中随时修改，无需重启

# 胜算云（推荐主力 — beta-router 统一入口）
VITE_SHENGSUANYUN_API_KEY=

# 中转站（自定义入口）
VITE_RELAY_BASE_URL=
VITE_RELAY_API_KEY=

# 硅基流动（备选）
VITE_SILICONFLOW_API_KEY=

# 智谱 GLM（中文/图片分析）
VITE_ZHIPU_API_KEY=

# DeepSeek（代码专用）
VITE_DEEPSEEK_API_KEY=